REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=./storage
# Ảnh người dùng + kết quả tự xoá sau N giờ
DATA_TTL_HOURS=6
MAX_UPLOAD_MB=10
# mock | catvton (tự thêm model của bạn trong worker/models)
VTON_MODEL=mock
# Shopee Affiliate Open API (tuỳ chọn) - https://affiliate.shopee.vn
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=
